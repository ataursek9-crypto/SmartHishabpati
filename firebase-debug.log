[debug] [2026-11-07T09:24:33.380Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Global Safety Net: Default-deny\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');\n    }\n\n    // Super Admin: Registry Check\n    function isRegistrySuperAdmin() {\n      return isSignedIn() &&\n        exists(/databases/$(database)/documents/platform_superadmins/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/platform_superadmins/$(request.auth.uid)).data.isActive == true &&\n        get(/databases/$(database)/documents/platform_superadmins/$(request.auth.uid)).data.role == 'SUPER_ADMIN';\n    }\n\n    // Explicit revocation check\n    function isRevokedSuperAdmin() {\n      return isSignedIn() && (\n        (('email' in request.auth.token) && request.auth.token.email != null && (\n          request.auth.token.email in [\n            'buddavaibinodon@gmail.com',\n            'gonee8666@gmail.com',\n            'ataulgonee786@gmail.com',\n            'ataurpos@gmail.com',\n            'ataur50305@gmail.com',\n            'a48268993@gmail.com',\n            'jamesfashion792@gmail.com',\n            'support@smartbiz.local'\n          ] ||\n          (request.auth.token.email is string &&\n           request.auth.token.email.lower() in [\n            'buddavaibinodon@gmail.com',\n            'gonee8666@gmail.com',\n            'ataulgonee786@gmail.com',\n            'ataurpos@gmail.com',\n            'ataur50305@gmail.com',\n            'a48268993@gmail.com',\n            'jamesfashion792@gmail.com',\n            'support@smartbiz.local'\n           ])\n        )) ||\n        (exists(/databases/$(database)/documents/platform_superadmins/$(request.auth.uid)) &&\n         get(/databases/$(database)/documents/platform_superadmins/$(request.auth.uid)).data.isActive == false)\n      );\n    }\n\n    // Super Admin: Master Email List (Google Verified Identity)\n    function isMasterAdminEmail() {\n      return isSignedIn() &&\n        ('email' in request.auth.token) &&\n        request.auth.token.email != null &&\n        (('email_verified' in request.auth.token && request.auth.token.email_verified == true) || ('firebase' in request.auth.token && 'sign_in_provider' in request.auth.token.firebase && request.auth.token.firebase.sign_in_provider == 'google.com')) && (\n          request.auth.token.email in [\n            'ataurgonee4@gmail.com',\n            'ataursek9@gmail.com'\n          ] ||\n          (request.auth.token.email is string &&\n           request.auth.token.email.lower() in [\n             'ataurgonee4@gmail.com',\n             'ataursek9@gmail.com'\n           ])\n        );\n    }\n\n    // Super Admin: Master Phone Number (Phone Auth Verified)\n    function isMasterAdminPhone() {\n      return isSignedIn() &&\n        ('phone_number' in request.auth.token) &&\n        request.auth.token.phone_number != null &&\n        request.auth.token.phone_number in ['+8801700000000', '01700000000'];\n    }\n\n    // Unified, synchronized Super Admin permission\n    function isSuperAdmin() {\n      return !isRevokedSuperAdmin() && (isRegistrySuperAdmin() || isMasterAdminEmail() || isMasterAdminPhone());\n    }\n\n    // Business ownership / staff helper\n    function isBusinessOwner(businessId) {\n      return isSignedIn() && (\n        isSuperAdmin() ||\n        request.auth.uid == businessId ||\n        (exists(/databases/$(database)/documents/businesses/$(businessId)) &&\n         (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid ||\n          ('adminUids' in get(/databases/$(database)/documents/businesses/$(businessId)).data &&\n           request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.adminUids))) ||\n        (exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)) &&\n         get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)).data.role == 'ADMIN' &&\n         get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)).data.isActive == true) ||\n        (exists(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)) &&\n         get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data.businessId == businessId &&\n         get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data.role == 'ADMIN' &&\n         get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data.isActive == true)\n      );\n    }\n\n    function isBusinessStaff(businessId) {\n      return isSignedIn() && (\n        isBusinessOwner(businessId) ||\n        (exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)) &&\n         get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)).data.isActive == true) ||\n        (('email' in request.auth.token) && request.auth.token.email != null &&\n         exists(/databases/$(database)/documents/businesses/$(businessId)/staff_by_email/$(request.auth.token.email)) &&\n         get(/databases/$(database)/documents/businesses/$(businessId)/staff_by_email/$(request.auth.token.email)).data.isActive == true) ||\n        (exists(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)) &&\n         get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data.businessId == businessId &&\n         get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data.isActive == true)\n      );\n    }\n\n    // Protection against privilege escalation by business owners on self-update\n    function isBusinessOwnerProfileUpdate(existingData, incomingData) {\n      return !incomingData.diff(existingData).affectedKeys().hasAny([\n        'subscriptionStatus',\n        'subscriptionExpiresAt',\n        'planId',\n        'planName',\n        'isAutoExpiryDisabled',\n        'status',\n        'maxStaffAllowed',\n        'scheduledPolicyChange',\n        'scheduledPolicyEffectiveAt',\n        'ownerUid'\n      ]);\n    }\n\n    // Validation blueprints\n    function isValidProduct(data) {\n      return data.id is string && data.id.size() <= 128 &&\n             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&\n             data.category is string && data.category.size() <= 100 &&\n             data.sellingPrice is number && data.sellingPrice >= 0 &&\n             data.currentStock is number &&\n             (!('purchasePrice' in data) || data.purchasePrice is number) &&\n             (!('unit' in data) || (data.unit is string && data.unit.size() <= 50)) &&\n             (!('isActive' in data) || data.isActive is bool) &&\n             (!('isDeleted' in data) || data.isDeleted is bool) &&\n             (!('imageUri' in data) || (data.imageUri is string && data.imageUri.size() <= 1000)) &&\n             (!('imageSource' in data) || (data.imageSource is string && data.imageSource.size() <= 50)) &&\n             (!('imageSourceInfo' in data) || (data.imageSourceInfo is string && data.imageSourceInfo.size() <= 200));\n    }\n\n    function isStaffStockUpdate(existingData, incomingData) {\n      return incomingData.diff(existingData).affectedKeys().hasOnly(['currentStock', 'updatedAt']) &&\n             incomingData.currentStock is number &&\n             (!('purchasePrice' in incomingData) || incomingData.purchasePrice == existingData.purchasePrice);\n    }\n\n    function isValidCustomer(data) {\n      return data.id is string && data.id.size() <= 128 &&\n             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&\n             data.phone is string && data.phone.size() <= 30 &&\n             data.currentDue is number &&\n             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&\n             (!('totalBilled' in data) || data.totalBilled is number) &&\n             (!('totalPaid' in data) || data.totalPaid is number) &&\n             (!('isDeleted' in data) || data.isDeleted is bool);\n    }\n\n    function isValidSale(data) {\n      return data.invoiceNumber is string && data.invoiceNumber.size() <= 128 &&\n             data.customerId is string && data.customerId.size() <= 128 &&\n             data.salesmanId is string && data.salesmanId.size() <= 128 &&\n             data.totalAmount is number && data.totalAmount >= 0 &&\n             (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0)) &&\n             (!('dueAmount' in data) || data.dueAmount is number) &&\n             (!('isDeleted' in data) || data.isDeleted is bool) &&\n             (!('items' in data) || data.items is list) &&\n             (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128));\n    }\n\n    function isDeviceAllowed(businessId, data) {\n      return !('deviceId' in data) ||\n             !exists(/databases/$(database)/documents/businesses/$(businessId)/active_devices/$(data.deviceId)) ||\n             get(/databases/$(database)/documents/businesses/$(businessId)/active_devices/$(data.deviceId)).data.isRevoked != true;\n    }\n\n    function isValidReceipt(data) {\n      return data.receiptNumber is string && data.receiptNumber.size() <= 128 &&\n             data.customerId is string && data.customerId.size() <= 128 &&\n             data.amount is number && data.amount > 0 &&\n             (!('isDeleted' in data) || data.isDeleted is bool);\n    }\n\n    function isValidExpense(data) {\n      return data.id is string && data.id.size() <= 128 &&\n             data.amount is number && data.amount > 0 &&\n             data.category is string && data.category.size() <= 50 &&\n             (!('status' in data) || (data.status is string && data.status in ['PENDING', 'APPROVED', 'REJECTED'])) &&\n             (!('reviewedAt' in data) || data.reviewedAt is number) &&\n             (!('isDeleted' in data) || data.isDeleted is bool);\n    }\n\n    function isValidProductSubmission(data) {\n      return data.id is string && data.id.size() <= 128 &&\n             data.name is string && data.name.size() > 0 &&\n             (!('status' in data) || (data.status is string && data.status in ['PENDING', 'APPROVED', 'NEEDS_CORRECTION', 'REJECTED']));\n    }\n\n    function isValidTombstone(data) {\n      return data.id is string && data.id.size() <= 128 &&\n             data.tableName is string && data.tableName.size() <= 50 &&\n             data.originalId is string && data.originalId.size() <= 128 &&\n             (!('isPermanent' in data) || data.isPermanent is bool);\n    }\n\n    function isValidNewShopRegistration(data, businessId) {\n      return (data.id == businessId || !('id' in data)) &&\n             (\n               (data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 200) ||\n               (data.name is string && data.name.size() > 0 && data.name.size() <= 200)\n             ) &&\n             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100)) &&\n             (\n               (data.ownerPhone is string && data.ownerPhone.size() >= 5 && data.ownerPhone.size() <= 30) ||\n               (data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30)\n             ) &&\n             (!('status' in data) || (data.status is string && data.status in ['ACTIVE', 'PENDING', 'SUSPENDED'])) &&\n             (!('planId' in data) || (data.planId is string && data.planId.size() <= 50)) &&\n             (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus in ['ACTIVE', 'PENDING', 'EXPIRED', 'TRIAL']));\n    }\n\n    function isInitialShopCompletion(existingData, incomingData, businessId) {\n      return (\n               (!('ownerPhone' in existingData) || !('phone' in existingData) || !('status' in existingData) || !('address' in existingData)) ||\n               (existingData.ownerUid == request.auth.uid && existingData.status in ['PENDING', 'ACTIVE'])\n             ) &&\n             isValidNewShopRegistration(incomingData, businessId) &&\n             (!('planId' in incomingData) || incomingData.planId in ['plan_free', 'free', 'basic', 'default']) &&\n             (!('status' in incomingData) || incomingData.status in ['PENDING', 'ACTIVE']) &&\n             (!('subscriptionStatus' in incomingData) || incomingData.subscriptionStatus in ['PENDING', 'ACTIVE', 'TRIAL']) &&\n             (!('ownerUid' in incomingData) || incomingData.ownerUid == existingData.ownerUid);\n    }\n\n    // Business Scope Root\n    match /businesses/{businessId} {\n      allow get: if isSuperAdmin() || (isSignedIn() && (\n        isBusinessStaff(businessId) ||\n        (resource != null && (\n          resource.data.ownerUid == request.auth.uid ||\n          (('email' in request.auth.token) && request.auth.token.email != null && 'ownerEmail' in resource.data && resource.data.ownerEmail == request.auth.token.email.lower())\n        ))\n      ));\n      allow list: if isSuperAdmin() || (isSignedIn() && (\n        resource.data.ownerUid == request.auth.uid ||\n        ('email' in request.auth.token && request.auth.token.email != null && 'ownerEmail' in resource.data && resource.data.ownerEmail == request.auth.token.email.lower()) ||\n        ('phone_number' in request.auth.token && request.auth.token.phone_number != null && (\n          ('ownerPhone' in resource.data && (\n            resource.data.ownerPhone == request.auth.token.phone_number ||\n            ('+88' + resource.data.ownerPhone) == request.auth.token.phone_number\n          )) ||\n          ('phone' in resource.data && (\n            resource.data.phone == request.auth.token.phone_number ||\n            ('+88' + resource.data.phone) == request.auth.token.phone_number\n          ))\n        ))\n      ));\n      allow create: if isSuperAdmin() || (\n        isSignedIn() && (\n          request.auth.uid == businessId ||\n          incoming().ownerUid == request.auth.uid ||\n          (!('ownerUid' in incoming()) && request.auth.uid == businessId)\n        ) &&\n        isValidNewShopRegistration(incoming(), businessId) &&\n        (!('planId' in incoming()) || incoming().planId in ['plan_free', 'free', 'basic', 'default']) &&\n        (!('status' in incoming()) || incoming().status in ['PENDING', 'ACTIVE']) &&\n        (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus in ['PENDING', 'ACTIVE', 'TRIAL'])\n      );\n      allow update: if isSuperAdmin() || (\n        isBusinessOwner(businessId) &&\n        (isBusinessOwnerProfileUpdate(existing(), incoming()) || isInitialShopCompletion(existing(), incoming(), businessId))\n      );\n      allow delete: if isSuperAdmin();\n\n      // 1. Products\n      match /products/{productId} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create: if isBusinessOwner(businessId) && isValidProduct(incoming());\n        allow update: if (isBusinessOwner(businessId) && isValidProduct(incoming())) ||\n                         (isBusinessStaff(businessId) && isStaffStockUpdate(existing(), incoming()));\n        allow delete: if isBusinessOwner(businessId);\n      }\n\n      // 2. Customers\n      match /customers/{customerId} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create, update: if isBusinessStaff(businessId) && isValidCustomer(incoming());\n        allow delete: if isBusinessOwner(businessId);\n      }\n\n      // 3. Sales (Invoices) - Staff can create & sync, only Owner can delete\n      match /sales/{invoiceNumber} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create: if isBusinessStaff(businessId) && isValidSale(incoming()) && isDeviceAllowed(businessId, incoming());\n        allow update: if (isBusinessOwner(businessId) || isBusinessStaff(businessId)) && isValidSale(incoming()) && isDeviceAllowed(businessId, incoming());\n        allow delete: if isBusinessOwner(businessId);\n      }\n\n      // 4. Payment Receipts - Staff can collect & sync, only Owner can delete\n      match /payments/{receiptNumber} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create, update: if isBusinessStaff(businessId) && isValidReceipt(incoming());\n        allow delete: if isBusinessOwner(businessId);\n      }\n\n      // 5. Expenses - Staff can log expenses, only Owner can approve or delete\n      match /expenses/{expenseId} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create: if isBusinessStaff(businessId) && isValidExpense(incoming());\n        allow update, delete: if isBusinessOwner(businessId);\n      }\n\n      // 6. Staff Accounts - Managed only by Owner; staff can only view own record\n      match /staff/{staffUid} {\n        allow get: if isBusinessOwner(businessId) || (isSignedIn() && request.auth.uid == staffUid);\n        allow list: if isBusinessOwner(businessId);\n        allow create, update, delete: if isBusinessOwner(businessId);\n      }\n\n      // 7. Shop Settings & Configuration - Managed & viewed only by Owner\n      match /settings/{settingId} {\n        allow get, list: if isBusinessOwner(businessId);\n        allow create, update, delete: if isBusinessOwner(businessId);\n      }\n\n      // 8. Staff Product Submissions - Staff propose items, Owner reviews/approves\n      match /product_submissions/{submissionId} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create: if isBusinessStaff(businessId) && isValidProductSubmission(incoming());\n        allow update: if isBusinessOwner(businessId) && isValidProductSubmission(incoming());\n        allow delete: if isBusinessOwner(businessId);\n      }\n\n      // 9. Tombstones for Syncing Deletions across devices\n      match /tombstones/{tombstoneId} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create: if isBusinessStaff(businessId) && isValidTombstone(incoming());\n        allow update, delete: if isBusinessOwner(businessId);\n      }\n\n      // 10. Staff mapping by phone & email\n      match /staff_by_phone/{phone} {\n        allow get: if isSignedIn();\n        allow list, create, update, delete: if isBusinessOwner(businessId);\n      }\n\n      match /staff_by_email/{email} {\n        allow get: if isSignedIn() && (\n          ((('email' in request.auth.token) && request.auth.token.email != null && (request.auth.token.email == email || request.auth.token.email.matches('(?i)^' + email + '$')))) ||\n          isBusinessOwner(businessId)\n        );\n        allow list, create, update, delete: if isBusinessOwner(businessId);\n      }\n\n      // 11. Active Device Sessions & Remote Revocation\n      match /active_devices/{deviceId} {\n        allow get, list: if isBusinessStaff(businessId);\n        allow create: if isBusinessOwner(businessId) || (\n                         isBusinessStaff(businessId) &&\n                         incoming().deviceId == deviceId &&\n                         incoming().userId == request.auth.uid &&\n                         (!('isRevoked' in incoming()) || incoming().isRevoked == false)\n                      );\n        allow update: if isBusinessOwner(businessId) || (\n          isBusinessStaff(businessId) &&\n          existing().userId == request.auth.uid &&\n          existing().isRevoked != true &&\n          !incoming().diff(existing()).affectedKeys().hasAny(['isRevoked', 'userId', 'deviceId'])\n        );\n        allow delete: if isBusinessOwner(businessId);\n      }\n    }\n\n    // 11. Registered phones index - strictly protected against scraping\n    match /registered_phones/{phone} {\n      allow get: if isSuperAdmin() || (isSignedIn() && (\n        resource.data.ownerUid == request.auth.uid ||\n        resource.data.businessId == request.auth.uid ||\n        isBusinessOwner(resource.data.businessId) ||\n        ('phone_number' in request.auth.token && request.auth.token.phone_number != null && (\n          request.auth.token.phone_number == phone ||\n          request.auth.token.phone_number == '+88' + phone ||\n          ('+88' + phone) == request.auth.token.phone_number\n        ))\n      ));\n      allow list: if isSuperAdmin();\n      allow create: if isSignedIn() && phone.size() >= 5 && phone.size() <= 30 &&\n                       incoming().phone == phone && incoming().businessId is string &&\n                       (isSuperAdmin() || incoming().businessId == request.auth.uid || incoming().ownerUid == request.auth.uid || isBusinessOwner(incoming().businessId)) &&\n                       (!exists(/databases/$(database)/documents/registered_phones/$(phone)) ||\n                        get(/databases/$(database)/documents/registered_phones/$(phone)).data.ownerUid == request.auth.uid);\n      allow update: if isSuperAdmin() || (\n        isSignedIn() && phone.size() >= 5 && phone.size() <= 30 &&\n        incoming().phone == phone && incoming().businessId is string &&\n        (incoming().businessId == request.auth.uid || incoming().ownerUid == request.auth.uid || isBusinessOwner(incoming().businessId) || resource.data.ownerUid == request.auth.uid)\n      );\n      allow delete: if isSuperAdmin();\n    }\n\n    // 12. Staff memberships index - managed only by Business Owner or Super Admin\n    match /staff_memberships/{userId} {\n      allow get: if isSignedIn() && (\n        request.auth.uid == userId ||\n        isSuperAdmin() ||\n        (resource != null && 'businessId' in resource.data && isBusinessOwner(resource.data.businessId))\n      );\n      allow list: if isSuperAdmin();\n      allow create, update: if isSuperAdmin() || (\n        isSignedIn() &&\n        incoming().businessId is string &&\n        isBusinessOwner(incoming().businessId) &&\n        incoming().role in ['SALESMAN', 'ADMIN'] &&\n        incoming().isActive is bool\n      );\n      allow delete: if isSuperAdmin() || (\n        isSignedIn() &&\n        resource != null &&\n        'businessId' in resource.data &&\n        isBusinessOwner(resource.data.businessId)\n      );\n    }\n\n    // 13. Platform Plans (Public plans read by signed-in users, managed by Super Admin)\n    match /platform_plans/{planId} {\n      allow get, list: if isSignedIn();\n      allow create, update, delete: if isSuperAdmin();\n    }\n\n    // 14. Platform Subscriptions\n    match /platform_subscriptions/{subId} {\n      allow get: if isSuperAdmin() || (isSignedIn() && resource != null && 'businessId' in resource.data && isBusinessStaff(resource.data.businessId));\n      allow list: if isSuperAdmin();\n      allow create, update, delete: if isSuperAdmin();\n    }\n\n    // 15. Platform Payments (Strictly validated self-shop creation, verified only by Super Admin)\n    match /platform_payments/{paymentId} {\n      allow get, list: if isSuperAdmin() || (isSignedIn() && resource != null && 'businessId' in resource.data && isBusinessStaff(resource.data.businessId));\n      allow create: if isSignedIn() &&\n        incoming().businessId is string &&\n        isBusinessStaff(incoming().businessId) &&\n        incoming().amount is number && incoming().amount > 0 && incoming().amount <= 10000000 &&\n        incoming().status == 'PENDING' &&\n        (!('verified' in incoming()) || incoming().verified == false);\n      allow update, delete: if isSuperAdmin();\n    }\n\n    // 16. Platform Audit Logs (Strictly immutable, created & read only by Super Admin)\n    match /platform_audit_logs/{logId} {\n      allow get, list: if isSuperAdmin();\n      allow create: if isSuperAdmin();\n      allow update, delete: if false;\n    }\n\n    // 17. Platform Settings (Only public 'global_config' readable by regular users; secrets guarded)\n    match /platform_settings/{settingId} {\n      allow get: if isSuperAdmin() || (isSignedIn() && settingId == 'global_config');\n      allow list: if isSuperAdmin();\n      allow create, update, delete: if isSuperAdmin();\n    }\n\n    // 18. Platform Super Admin Registry\n    match /platform_superadmins/{uid} {\n      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());\n      allow list: if isSuperAdmin();\n      allow create: if isSuperAdmin() || (isMasterAdminEmail() && request.auth.uid == uid);\n      allow update, delete: if isSuperAdmin();\n    }\n\n    // 19. User Identity Mappings (Server-Verified Account Linking between Firebase & Supabase)\n    match /user_identity_mappings/{firebaseUid} {\n      allow get: if isSuperAdmin() || (isSignedIn() && request.auth.uid == firebaseUid);\n      allow create, update: if isSignedIn() && request.auth.uid == firebaseUid && incoming().firebaseUid == request.auth.uid;\n      allow delete: if isSuperAdmin();\n    }\n  }\n}\n"}]}}
